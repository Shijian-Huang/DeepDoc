# Local Qwen through Ollama (default)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
DEEPDOC_OLLAMA_MODELS=qwen3:8b,qwen3:4b
OLLAMA_CONTEXT_LENGTH=12288
OLLAMA_NUM_PREDICT=3072
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m

# false: allow Ollama to use an available GPU/Metal accelerator
# true: force CPU-only execution for VPS benchmarks
OLLAMA_CPU_ONLY=false

# Optional Ollama model storage directory (use project storage on WAVE)
# OLLAMA_MODELS=/WAVE/projects2/DeepDoc/ollama-models

# Optional Gemini provider
GEMINI_API_KEY=
