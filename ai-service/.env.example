# Gemini is the default provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Optional cache directory for MiniCheck-Flan-T5-Large evaluation weights
# MINICHECK_CACHE_DIR=/path/to/minicheck-cache

# Optional local Qwen provider through Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Local evaluation judge; unset or leave empty to use Gemini instead
OLLAMA_JUDGE_MODEL=gpt-oss:20b
# Includes reasoning tokens; independent of the summary output budget
OLLAMA_JUDGE_NUM_PREDICT=8192
# GEMINI_EVALUATOR_MODEL=gemini-3.5-flash-lite
DEEPDOC_OLLAMA_MODELS=qwen3:8b,qwen3:4b
OLLAMA_CONTEXT_LENGTH=12288
OLLAMA_NUM_PREDICT=3072
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m

# false: allow Ollama to use an available GPU/Metal accelerator
# true: force CPU-only execution for VPS benchmarks
OLLAMA_CPU_ONLY=false

# Optional Ollama model storage directory (use project storage on WAVE)
# OLLAMA_MODELS=/WAVE/projects2/DeepDoc/ollama-models

# Narrated MP4 generation (requires ffmpeg and Piper); paused by default
VIDEO_ENABLED=false
